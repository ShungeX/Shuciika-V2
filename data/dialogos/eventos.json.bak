    "dialogos": [
      {
        "step": 0,
        "action": {
          "type": "send",
          "guardar": "vacio"
        },
        "content": "-# ** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n** **\n",
        "delay": 0
      },
      {
        "step": 1,
        "action": {
          "type": "send",
          "guardar": "main"
        },
        "content": "-# **Entras en un sueño profundo,tu cuerpo se relaja y todo el ruido de tu alrededor desaparece...**\n-# *La oscuridad te envuelve suavemente.*",
        "delay": 0
      },
      {
        "step": 2,
        "action": {
          "type": "edit",
          "target": "main"
        },
        "content": "-# *Tu alma resuena más allá de lo que tus ojos pueden ver*",
        "delay": 12000,
        "nextStep": 40
      },
      {
        "step": 3,
        "action": {
          "type": "edit",
          "target": "main"
        },
        "content": "*Al abrir tus ojos... notas una hermosa realidad.*",
        "delay": 6000
      },
      {
        "step": 4,
        "action": {
          "type": "edit",
          "target": "main"
        },
        "content": "Ante ti, un hermoso jardín, perfectamente cuidado y ordenado, aunque... todo se siente antinatural; Los árboles crecen sin hojas y las flores solo son de un color brillante. Todo lo demas esta rodeado de oscuridad.",
        "files": [
          "https://i.pinimg.com/originals/61/77/15/61771528347afd26037a1b321bf22bb7.gif"
        ],
        "delay": 4000
      },
      {
        "step": 5,
        "action": {
          "type": "edit",
          "target": "main"
        },
        "content": "En el cielo no hay sol, solo una luz brillante que ilumina lo poco que ves. Y más alla del jardín, todo esta rodeado de muros altos. ",
        "files": [
          "https://files.catbox.moe/d295gl.gif"
        ],
        "delay": 11000
      },
      {
        "step": 6,
        "action": {
          "type": "edit",
          "target": "main"
        },
        "content": "Sin embargo, *Una tenue y dulce voz te habla*",
        "files": [],
        "delay": 8000
      },
      {
        "step": 7,
        "action": {
          "type": "edit",
          "target": "main"
        },
        "content": "** **",
        "delay": 6000,
        "embeds": [
          {
            "author": {
              "name": "¿?"
            },
            "description": "Aunque extraño… sigue siendo hermoso. ¿No lo crees?",
            "color": "Purple"
          }
        ]
      },
      {
        "step": 8,
        "action": {
          "type": "edit",
          "target": "main"
        },
        "content": "",
        "delay": 7000,
        "embeds": [
          {
            "author": {
              "name": "¿?"
            },
            "description": "Tranquilo. Estoy aquí para orientarte",
            "color": "DarkPurple"
          }
        ]
      },
      {
        "step": 9,
        "action": {
          "type": "edit",
          "target": "main"
        },
        "content": "",
        "delay": 7000,
        "skip": 18000,
        "embeds": [
          {
            "author": {
              "name": "¿?"
            },
            "description": "¿Quieres empezar a caminar?",
            "color": "DarkPurple"
          }
        ],
        "components": [
          {
            "type": "BUTTON",
            "customId": "dialogue_button-{user_id}-despertar-act-0-{code}",
