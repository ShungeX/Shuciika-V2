# ─────────────────────────────────────────────────────────────────────────────
# Navi (versión de trabajo) ⇄ Shuciika (versión final)
#
# Todo lo que cambia entre las dos versiones está en config/entorno.js.
#
# Forma A — la más simple: un solo token.
#   Pon TOKEN_BOT con el token del bot que quieras usar. El bot lee su propio
#   ID dentro del token y sabe solo si es Navi o Shuciika. BOT_ENTORNO no hace falta.
#
# Forma B — las dos configuraciones a la vez.
#   Cualquier variable puede llevar el sufijo _NAVI o _SHUCIIKA, que gana sobre
#   la normal. Rellena las dos versiones y cambia solo BOT_ENTORNO.
#   (Con esta forma BOT_ENTORNO es obligatorio.)
#
# Qué cambia al pasar a Shuciika:
#   - Comandos: /rol en vez de /navi-rol (los de Navi llevan prefijo navi-).
#   - Eventos de producción activos: despedidas al salir del servidor y alianzas.
#   - Envíos automáticos activos: noticiero del clima, resumen diario de economía,
#     diálogos programados, aviso de 1 hora de la apertura y refresco de paneles de
#     tienda. En Navi solo se mandan a mano desde el dashboard.
#   - Token, app de Discord del login web y, si lo defines, la base de datos.
# ─────────────────────────────────────────────────────────────────────────────

# navi | shuciika   (vacío = se detecta por el token)
BOT_ENTORNO= 

# Envíos automáticos (vacío = lo que diga el entorno: no en Navi, sí en Shuciika).
# Pon si para probarlos con Navi. Ojo: si las dos versiones usan la misma base,
# Navi y Shuciika se pelearían los mismos mensajes.
ENVIOS_AUTOMATICOS=

# Forma A
TOKEN_BOT=

# Forma B
# TOKEN_BOT_NAVI=
# TOKEN_BOT_SHUCIIKA=

# Base de datos. Pon MONGODB_URI_NAVI si quieres que Navi use otra base
# y no toque los datos reales mientras pruebas.
MONGODB_URI=
# MONGODB_URI_NAVI=
# MONGODB_URI_SHUCIIKA=

# Login del dashboard (OAuth de Discord). Si falta ClientID se usa el ID del bot.
ClientID=
ClientSecret=
# ClientID_NAVI=
# ClientSecret_NAVI=
# ClientID_SHUCIIKA=
# ClientSecret_SHUCIIKA=

# URL a la que Discord regresa tras el login. Debe estar dada de alta en el
# portal de desarrolladores de la app. Por defecto: http://localhost:PORT/api/auth/discord/redirect
# OAUTH_REDIRECT_URI_SHUCIIKA=https://tu-dominio/api/auth/discord/redirect

# Servidor web
PORT=3000
FRONTEND_URL=http://localhost:5173
# FRONTEND_URL_SHUCIIKA=https://tu-dominio
SESSION_SECRET=

# Cloudinary
CLOUD_NAME=
API_KEY=
API_SECRET=
